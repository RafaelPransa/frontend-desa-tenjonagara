# ──────────────────────────────────────────────────────────────────
# Frontend Environment Variables – Website Profil Desa Tenjonagara
# ──────────────────────────────────────────────────────────────────

# Base URL Backend API
# Development (lokal):
#   VITE_API_BASE_URL=http://localhost:5000/api
# Production (VPS Biznet, satu server):
#   VITE_API_BASE_URL=https://<IP-atau-domain>/api
# Production (subdomain terpisah):
#   VITE_API_BASE_URL=https://api.tenjonagara.id/api

VITE_API_BASE_URL=http://localhost:5000/api
